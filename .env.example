# Keep the real .env local; it is ignored by git.
OPENAI_API_KEY=replace-with-your-key

# GPT-5.6 Luna is the cost-efficient model used for short, structured briefs.
OPENAI_MODEL=gpt-5.6-luna

# Luna supports: none, low, medium, high, xhigh, and max.
# Low is appropriate for this latency-sensitive rewrite over verified facts.
OPENAI_REASONING_EFFORT=low
